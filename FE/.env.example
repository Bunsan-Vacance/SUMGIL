# Kakao Developers > 플랫폼 키 > JavaScript 키
# 허용 도메인: http://127.0.0.1:5173 , http://localhost:5173
VITE_KAKAO_MAP_APP_KEY=
VITE_API_BASE_URL=http://70.12.246.138:8080
# true면 VITE_API_BASE_URL이 있어도 경로 검색만 API 형식 mock 응답을 사용한다.
VITE_ROUTE_SEARCH_MOCK=false
# true면 도착 시 따릉이 예측만 API 형식 mock 응답을 사용한다.
VITE_BIKE_PREDICTION_MOCK=false
# true면 조회 대여소의 자전거 6대·총 거치대 6개 혼잡 샘플 응답을 사용한다. 경로·예측 mock과 함께 시연한다.
VITE_BIKE_STOCK_MOCK=false
# true면 탑승 확인·잔여 경로 재탐색만 API 형식 mock 응답을 사용한다.
VITE_GUIDANCE_MOCK=false
# AI(TIME) 서버 베이스 URL. 비어 있고 VITE_REROUTE_MOCK도 false면 재안내 확인을 하지 않는다. 로컬 개발은 /ai(vite proxy →
# 운영 이미지는 GitLab CI 변수 VITE_AI_BASE_URL=/ai로 주입한다(.gitlab/ci/fe.yml).
# localhost:8000), 운영은 Ingress /ai/** 경로를 쓴다.
VITE_AI_BASE_URL=
# true면 VITE_AI_BASE_URL이 있어도 재안내 확인만 API 형식 mock 응답을 사용한다.
VITE_REROUTE_MOCK=false
# mock일 때 반환할 상태(no_trigger·no_alternative·unavailable·proposal 중 하나).
VITE_REROUTE_MOCK_STATUS=proposal
# true면 재안내 확인 요청에 debugForceTrigger:true를 실어 임계값을 건너뛴다(시연용, dev 서버 전용).
VITE_REROUTE_DEBUG_FORCE=false
