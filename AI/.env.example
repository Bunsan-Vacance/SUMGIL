# 서울 열린데이터광장 일반 인증키 (data.seoul.go.kr)
SEOUL_API_KEY=

# 서울 열린데이터광장 지하철 전용 인증키 — getStnPsgr(D−1 승하차 수집) 등. 없으면 SEOUL_API_KEY를 쓴다
SEOUL_SUBWAY_KEY=

# 서울 열린데이터광장 따릉이(bikeList) 전용 인증키 (있다면 SEOUL_API_KEY와 별도)
SEOUL_BIKE_KEY=

# 기상청 API허브 인증키 (apihub.kma.go.kr)
KMA_API_KEY=

# Discord Webhook URL (데이터 수집 모니터링 실패 알림 전송용, 선택)
DISCORD_WEBHOOK_URL=

# 데이터 수집 모니터링 알림 메시지에 표시할 서버 이름
DATA_ENGINE_SERVER_NAME=J15A104A

# Google Drive 인증 방식 (Shared with me/My Drive 업로드는 oauth 사용)
DATA_ENGINE_DRIVE_AUTH_MODE=oauth

# Google Drive OAuth token 파일 경로 (repo 밖에 저장)
GOOGLE_OAUTH_TOKEN_FILE=

# Google Drive 백업 루트 폴더 ID (URL 전체가 아니라 folders/ 뒤 ID만 입력)
GOOGLE_DRIVE_ARCHIVE_ROOT_FOLDER_ID=

# Google Drive 따릉이 전용 백업 루트 폴더 ID (있으면 BIKE/ prefix 없이 이 폴더 아래 raw/부터 저장)
GOOGLE_DRIVE_BIKE_ARCHIVE_ROOT_FOLDER_ID=

# Google Drive 따릉이 전용 백업 루트 폴더 위치: domain(BIKE), raw(BIKE/raw), realtime(BIKE/raw/realtime)
GOOGLE_DRIVE_BIKE_ARCHIVE_ROOT_LEVEL=domain

# Google Drive 날씨 전용 백업 루트 폴더 ID (있으면 EXTERNAL/weather/ prefix 없이 이 폴더 아래 raw/부터 저장)
GOOGLE_DRIVE_WEATHER_ARCHIVE_ROOT_FOLDER_ID=

# Google Drive 날씨 전용 백업 루트 폴더 위치: domain(EXTERNAL/weather), raw(EXTERNAL/weather/raw), nowcast(EXTERNAL/weather/raw/nowcast)
GOOGLE_DRIVE_WEATHER_ARCHIVE_ROOT_LEVEL=domain

# 데이터 archive storage (현재: drive, 향후: s3/hdfs 등으로 확장 가능)
DATA_ENGINE_ARCHIVE_STORAGE=drive
