# 서울 열린데이터광장 일반 인증키 (data.seoul.go.kr)
SEOUL_API_KEY=

# 서울 열린데이터광장 지하철 전용 인증키 — getStnPsgr(D−1 승하차 수집) 등. 없으면 SEOUL_API_KEY를 쓴다
SEOUL_SUBWAY_KEY=

# 서울 열린데이터광장 따릉이(bikeList) 전용 인증키 (있다면 SEOUL_API_KEY와 별도)
SEOUL_BIKE_KEY=

# BIKE avg 배치 입력 폴더 (AI/ 기준 상대 경로, stock_profile_avg.parquet 포함)
BIKE_AVG_ARTIFACT=models/BIKE/<검증된-아티팩트-폴더>

# 기상청 API허브 인증키 (apihub.kma.go.kr)
KMA_API_KEY=

# LLM API 인증키 — 실시간 재탐색 에이전트(TIME-001, S15P21A104-202·203)가 쓴다
GMS_API_KEY=

# Discord Webhook URL (데이터 수집 모니터링 실패 알림 전송용, 선택)
DISCORD_WEBHOOK_URL=

# 데이터 수집 모니터링 알림 메시지에 표시할 서버 이름
DATA_ENGINE_SERVER_NAME=J15A104A

# Google Drive 인증 방식 (Shared with me/My Drive 업로드는 oauth 사용)
DATA_ENGINE_DRIVE_AUTH_MODE=oauth

# Google Drive OAuth token 파일 경로 (repo 밖에 저장)
GOOGLE_OAUTH_TOKEN_FILE=

# Google Drive 백업 루트 폴더 ID (URL 전체가 아니라 folders/ 뒤 ID만 입력)
GOOGLE_DRIVE_ARCHIVE_ROOT_FOLDER_ID=

# Google Drive 따릉이 전용 백업 루트 폴더 ID (있으면 BIKE/ prefix 없이 이 폴더 아래 raw/부터 저장)
GOOGLE_DRIVE_BIKE_ARCHIVE_ROOT_FOLDER_ID=

# Google Drive 따릉이 전용 백업 루트 폴더 위치: domain(BIKE), raw(BIKE/raw), realtime(BIKE/raw/realtime)
GOOGLE_DRIVE_BIKE_ARCHIVE_ROOT_LEVEL=domain

# Google Drive 날씨 전용 백업 루트 폴더 ID (있으면 EXTERNAL/weather/ prefix 없이 이 폴더 아래 raw/부터 저장)
GOOGLE_DRIVE_WEATHER_ARCHIVE_ROOT_FOLDER_ID=

# Google Drive 날씨 전용 백업 루트 폴더 위치: domain(EXTERNAL/weather), raw(EXTERNAL/weather/raw), nowcast(EXTERNAL/weather/raw/nowcast)
GOOGLE_DRIVE_WEATHER_ARCHIVE_ROOT_LEVEL=domain

# Google Drive 지하철 전용 백업 루트 폴더 ID (있으면 SUBWAY/ prefix 없이 이 폴더 아래 raw/부터 저장)
GOOGLE_DRIVE_SUBWAY_ARCHIVE_ROOT_FOLDER_ID=

# Google Drive 지하철 전용 백업 루트 폴더 위치: domain(SUBWAY), raw(SUBWAY/raw), arrival(SUBWAY/raw/arrival)
GOOGLE_DRIVE_SUBWAY_ARCHIVE_ROOT_LEVEL=domain

# 데이터 archive storage (현재: drive, 향후: s3/hdfs 등으로 확장 가능)
DATA_ENGINE_ARCHIVE_STORAGE=drive

# Kafka bootstrap server 주소 (J15A104A에서는 /etc/hosts에 kafka 등록 후 사용)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# AI Kafka consumer group (BE Redis consumer와 offset 분리)
KAFKA_CONSUMER_GROUP=ai-spark

# Kafka consumer 최초 offset reset 정책 (48h retention 내 과거 이벤트부터 적재)
KAFKA_AUTO_OFFSET_RESET=earliest

# Kafka topic 이름
KAFKA_TOPIC_BIKE_STOCK=bike.stock
KAFKA_TOPIC_WEATHER_NOWCAST=weather.nowcast
KAFKA_TOPIC_SUBWAY_ARRIVAL=subway.arrival

# 지하철 수집 모니터 운영 시간(KST, HH:MM). 이 시간 밖에는 freshness·수집량 검사를 skip한다.
# 종료가 시작보다 이르면 자정을 넘는 구간으로 본다. producer 실제 운영 시간에 맞춰 조정.
SUBWAY_OPERATING_START=05:30
SUBWAY_OPERATING_END=01:00

# Kafka consumer 처리 상태·lag 이력 파일 (기본: AI/logs/ 아래)
# KAFKA_CONSUMER_STATUS_PATH=logs/kafka_consumer_status.json
# KAFKA_LAG_HISTORY_PATH=logs/kafka_lag_history.json
