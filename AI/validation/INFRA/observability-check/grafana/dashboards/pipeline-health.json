    {
      "id": 7,
      "type": "table",
      "title": "재학습 러너 단계 (ops API /ops/jobs)",
      "description": "retrain_state.json의 run x step. rc 0 초록, 그 외 빨강.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity-ai"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity-ai"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "/ops/jobs?limit=20",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "parser": "backend",
          "root_selector": "",
          "columns": [
            {
              "selector": "run_id",
              "text": "run_id",
