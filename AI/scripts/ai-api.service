
# systemd 유닛 템플릿. 설치 시 <REPO_ROOT>/<VENV_PATH>를 실제 경로로 치환한다.
#
#   sed -e "s|<REPO_ROOT>|/home/ubuntu/Soomgil-INFRA-ai-data-monitoring|g" \
#       -e "s|<VENV_PATH>|/home/ubuntu/Soomgil-INFRA-ai-data-monitoring/AI/.venv|g" \
#       ai-api.service | sudo tee /etc/systemd/system/ai-api.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ai-api
#   sudo systemctl status ai-api

[Unit]
Description=S15P21A104 AI Gateway (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
# --host는 이 서버의 Tailscale IP로 고정 — 0.0.0.0이 아니라서 퍼블릭/VPC 대역으로는
# 안 열리고 Tailscale 사설망(BE가 붙는 경로)으로만 접근 가능하다.
Type=simple
WorkingDirectory=<REPO_ROOT>/AI
EnvironmentFile=<REPO_ROOT>/AI/.env
ExecStart=<VENV_PATH>/bin/uvicorn app.main:app --host 100.64.193.109 --port 8000
Restart=always
RestartSec=10
StandardOutput=append:<REPO_ROOT>/AI/logs/ai-api.log
StandardError=append:<REPO_ROOT>/AI/logs/ai-api.log

[Install]
WantedBy=multi-user.target
