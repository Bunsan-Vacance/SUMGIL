DB_URL=jdbc:postgresql://localhost:5432/sumgil
DB_USERNAME=sumgil
DB_PASSWORD=sumgil1234
REDIS_HOST=localhost
REDIS_PORT=6379
# Kafka 브로커 주소 (S15P21A104-74·169). 수집기(collect 프로파일)가 붙는 주소이고, 비우면 KafkaRoundTripIT·CollectorKafkaIT 를 건너뛴다.
# 브로커 기동은 BE/docs/infra/kafka.md 참고. 로컬 compose 컨테이너 안에서는 kafka:19092, prod 클러스터 파드에서는 kafka:9092 다.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── 수집기 주기·운영 시간 창 (S15P21A104-170, BE/docs/infra/collector.md) ──
# 창은 KST "HH:mm-HH:mm"(종료 미포함). 키당 하루 1,000회 한도라 3분할 호출 기준 333회차가 예산이다.
# 기본값(주석)을 쓰면 비워 둔다. 발표 시간대에 맞출 때만 채운다.
# COLLECT_SUBWAY_INTERVAL=60s        # 60초 × 5.5h = 330회차 × 3회 = 990회
# COLLECT_SUBWAY_WINDOW=07:30-13:00
# COLLECT_BIKE_INTERVAL=120s         # 120초 × 11h = 330회차 × 3회 = 990회
# COLLECT_BIKE_WINDOW=07:00-18:00
# COLLECT_WEATHER_INTERVAL=1h        # 기상청은 별도 키·한도. 하루 24회차 × 2회
# COLLECT_WEATHER_WINDOW=00:00-24:00
# COLLECT_DAILY_CALLS=1000           # 소스별 하루 호출 상한 (안전장치)

# ── 외부 데이터 소스 인증키 (C 파트 · BE/scripts/external/probe.mjs, BE/docs/external/api-survey.md 참고) ──
# 서울 열린데이터광장 일반 인증키 (data.seoul.go.kr → 마이페이지 → 인증키 신청)
SEOUL_API_KEY=
# 실시간 지하철 도착정보 전용 인증키 (일반키와 별도 발급). 비우면 SEOUL_API_KEY 로 시도한다
SEOUL_SUBWAY_KEY=
# 따릉이 bikeList 전용 인증키 (있다면). 비우면 SEOUL_API_KEY 로 시도한다
SEOUL_BIKE_KEY=
# 공공데이터포털(data.go.kr) 디코딩(Decoding) 키 — 서울특별시_버스도착정보조회 서비스. 인코딩 키를 넣지 않는다
DATA_GO_KR_KEY=
