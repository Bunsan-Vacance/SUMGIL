DB_URL=jdbc:postgresql://localhost:5432/sumgil
DB_USERNAME=sumgil
DB_PASSWORD=sumgil1234
REDIS_HOST=localhost
REDIS_PORT=6379
# Kafka 브로커 주소 (S15P21A104-74). 비우면 KafkaRoundTripIT 를 건너뛴다.
# 브로커 기동은 BE/docs/infra/kafka.md 참고. 컨테이너 안에서는 kafka:19092 다.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── 외부 데이터 소스 인증키 (C 파트 · BE/scripts/external/probe.mjs, BE/docs/external/api-survey.md 참고) ──
# 서울 열린데이터광장 일반 인증키 (data.seoul.go.kr → 마이페이지 → 인증키 신청)
SEOUL_API_KEY=
# 실시간 지하철 도착정보 전용 인증키 (일반키와 별도 발급). 비우면 SEOUL_API_KEY 로 시도한다
SEOUL_SUBWAY_KEY=
# 따릉이 bikeList 전용 인증키 (있다면). 비우면 SEOUL_API_KEY 로 시도한다
SEOUL_BIKE_KEY=
# 공공데이터포털(data.go.kr) 디코딩(Decoding) 키 — 서울특별시_버스도착정보조회 서비스. 인코딩 키를 넣지 않는다
DATA_GO_KR_KEY=

# 카카오맵 도보 경로 조회 REST API 키 (S15P21A104-186). 비워두면 WALK leg의 geometry는
# 기존처럼 "unavailable"로 남는다 — 원천 선정·쿼터·요금은 팀 합의 후 채운다.
KAKAO_REST_API_KEY=
