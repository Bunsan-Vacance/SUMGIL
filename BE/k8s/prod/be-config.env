# BE 비민감 설정 (S15P21A104-126). 커밋 대상 — configMapGenerator가 be-config ConfigMap으로 만든다.
# 비밀값(DB_PASSWORD)은 데이터 계층(Infra) 소유다. Infra/k8s/prod/data-secret.env → data-secret Secret. BE는 소비만 한다.
DB_URL=jdbc:postgresql://postgres:5432/sumgil
DB_USERNAME=sumgil
REDIS_HOST=redis
REDIS_PORT=6379
APP_CORS_ALLOWED_ORIGINS=https://j15a104.p.ssafy.io

# 운영 프로파일: logback prod(표준출력 JSON) + JPA SQL 로그 억제
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_SHOW_SQL=false

# 따릉이 도착 예측의 AI 실시간 모델 (S15P21A104-309). AI API(ai-api.service)가 워커 노드 Tailscale 주소에만 떠 있다.
# k3s 노드 IP 가 Tailscale 이라 두 노드의 be 파드 모두 닿는다 (2026-09-23 실측 200 · 0.34~0.39초).
# 비우면 기능이 꺼지고 평균표로 나간다.
AI_API_BASE_URL=http://100.64.193.109:8000

# 레지스트리 주소 (인프라 값). kustomization.yaml의 images.newName과 일치해야 한다.
REGISTRY_HOST=100.103.156.53:30500

# --- 실시간 수집기 (collect 프로파일) ---
# 기본값 원본은 BE/src/main/resources/application-collect.yml, 값의 근거는 BE/docs/infra/collector.md 5절.
# 인증키는 be-secret.env → be-secret. 클러스터 안에서는 Service 이름으로 붙는다 (kafka.yaml, ClusterIP 전용).

# 소스별 하루 호출 상한. 열린데이터광장 키가 하루 1,000회다 (S15P21A104-170)
COLLECT_DAILY_CALLS=1000
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# 지하철 실시간 도착 — 1회 1,000행 제한이라 회차당 3분할. 60초 × 5h30m = 330회차 × 3회 = 990회
# 창을 옮길 때는 5시간 30분 폭을 유지해야 예산 안에 든다. 발표 시간대가 정해지면 그 시간대로 옮긴다.
COLLECT_SUBWAY_INTERVAL=60s
COLLECT_SUBWAY_WINDOW=10:00-15:30

# 따릉이 재고 — 회차당 3분할. 120초 × 11h = 330회차 × 3회 = 990회
COLLECT_BIKE_INTERVAL=120s
COLLECT_BIKE_WINDOW=07:00-18:00

# 기상청 API허브 — 별도 키·별도 한도라 하루 종일 매시. 회차당 2회(실황+예보) × 24 = 48회
COLLECT_WEATHER_INTERVAL=1h
COLLECT_WEATHER_WINDOW=00:00-24:00

# --- 실시간 컨슈머 (consume 프로파일) ---
# 기본값 원본은 BE/src/main/resources/application-consume.yml, 값의 근거는 BE/docs/infra/consumer.md.
# COLLECT_SUBWAY_WINDOW는 같은 파일에 있어 수집기와 항상 같은 값이다 (상태 키 판정용).
# 컨슈머는 외부 API를 부르지 않으므로 be-secret을 물리지 않는다.

# BE 반영용 컨슈머 그룹. AI Spark의 ai-spark와 반드시 달라야 한다 —
# 같으면 카프카가 메시지를 나눠 줘서 양쪽 다 일부만 받는다 (BE/docs/infra/kafka.md 5절).
CONSUME_GROUP_ID=be-redis
