# 앱 고유 비밀 키 목록 (S15P21A104-173). CONTRACT.md 4절 "비밀(앱) → be-secret" 자리다.
# 값은 커밋하지 않는다 — 이 파일은 키 이름만 두고, 실값은 be-secret.env 에 담는다(.gitignore 의 *-secret.env 규칙).
#
#   cp be-secret.env.example be-secret.env   # 노드에서. 값은 별도 채널로 받은 것을 채운다
#
# 실행 환경 주의: 로컬 개발용 BE/.env 와는 별개 파일이다 (CONTRACT.md 4절).
# 지금은 로컬과 prod 가 같은 서울시 키를 쓰므로 하루 1,000회 예산을 나눠 쓴다 — prod 수집기가 뜨면
# 로컬 수집기는 중단한다. 키 분리는 후속 과제.

SEOUL_SUBWAY_KEY=
SEOUL_API_KEY=
SEOUL_BIKE_KEY=
KMA_API_KEY=
KAKAO_REST_API_KEY=

# 저녁 수집기(be-collector-evening.yaml) 둘째 키 — 15:30 이후 창은 이 키로 돈다. 다른 팀원 계정에서 발급한 것이라
# 위 키와 한도(1,000회/일)가 따로다. render-secrets.sh 는 이 파일의 키를 전부 요구하므로 GitLab 변수에도 같은
# 이름으로 등록한다 (register-gitlab-vars.sh 가 이 파일에서 이름을 읽는다).
SEOUL_SUBWAY_KEY_EVENING=
SEOUL_BIKE_KEY_EVENING=

# 버스 실시간 혼잡도(S15P21A104-297) 조회용 공공데이터포털 디코딩 키.
# TAGO 지하철정보(15098554)와 같은 키지만 활용신청이 달라 한도가 별개다(도착정보 1,000/일).
# GitLab 변수 등록 완료(2026-09-21) → 렌더 대상에 넣는다.
DATA_GO_KR_KEY=
